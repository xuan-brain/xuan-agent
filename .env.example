{
  "ai_provider": {
    "provider": "siliconflow",
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key": "YOUR_API_KEY",
    "model": "deepseek-ai/DeepSeek-V3",
    "description": "硅基流动 DeepSeek 配置示例"
  },
  "db": {
    "connect": "http://127.0.0.1:8000",
    "user": "root",
    "pass": "secret",
    "namespace": "agent",
    "database": "dev"
  },
  "system_prompt": {
    "base": "你是 XuanAgent，一个专业的科研 AI 助手。",
    "tools_template": "\n## 可用工具\n\n你有以下工具可以使用：\n\n{tools}\n\n当需要使用工具时，请在回复中明确指出要调用的工具名称和参数。\n"
  }
}
